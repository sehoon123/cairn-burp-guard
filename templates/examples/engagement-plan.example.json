  "intents": [
    {"slot": "p01", "origin_index": 0, "paths": ["/public/"], "methods": ["GET"], "query_keys": [], "checks": ["bounded_public_link_discovery"], "max_requests": 20, "wall_seconds": 120, "concurrency": 1},
    {"slot": "p02", "origin_index": 0, "paths": ["/public/info"], "methods": ["HEAD"], "query_keys": [], "checks": ["status_header_content_type_metadata"], "max_requests": 20, "wall_seconds": 120, "concurrency": 1},
    {"slot": "p03", "origin_index": 0, "paths": ["/public/search"], "methods": ["GET"], "query_keys": ["q"], "checks": ["benign_non_executing_text_marker_comparison"], "max_requests": 20, "wall_seconds": 120, "concurrency": 1}
